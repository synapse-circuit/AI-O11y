# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Grafana Cloud Agent Observability (generation + tool-call ingest) ---
# Find all four values on the Connection tab of the AI Observability plugin
# in your Grafana Cloud stack: https://<your-stack>.grafana.net/plugins/grafana-sigil-app
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=your-instance-id
AGENTO11Y_AUTH_TOKEN=your-api-token

# --- OpenTelemetry traces/metrics (Grafana Cloud OTLP gateway) ---
# Same instance ID + API token as above, base64-encoded as "instanceID:apiToken".
OTEL_SERVICE_NAME=ai-o11y-agent-demo
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(instanceID:apiToken)

# --- Offline evaluations (evals/run_experiment.py) -- optional ---
# Keep AGENTO11Y_INGEST_ACTOR stable across runs: a run and its trials must
# share one actor, or trial creation fails with "401: experiment is owned by
# another actor". Leave AGENTO11Y_EXPERIMENT_ID unset to get a fresh id per run.
AGENTO11Y_INGEST_ACTOR=ingest:sdk/python
#AGENTO11Y_EXPERIMENT_ID=acme-support-starter-manual
